{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onetime-api",
  "version": "0.2.0",
  "identifier": "com.ubuntu.onetime-api",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OneTime API · 一次性 API 启动器",
        "width": 860,
        "height": 620,
        "minWidth": 700,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Launch CLI agents with temporary API credentials",
    "longDescription": "Store short-lived API endpoints and keys, then launch CLI agents in an isolated terminal environment without changing global configuration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
