{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "onetime-api",
  "version": "0.1.0",
  "identifier": "com.ubuntu.onetime-api",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "onetime-api · 一次性 API 启动器",
        "width": 720,
        "height": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
